<Project Sdk="Microsoft.NET.Sdk">
  <!-- The iPad app: starts the shared app with the iPad adapters and bundles the speech models. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RootNamespace>SpellingBee.App.iOS</RootNamespace>
    <ApplicationTitle>Spelling Bee</ApplicationTitle>
    <ApplicationId>local.spellingbee.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Assets.xcassets/AppIcon.appiconset, drawn by scripts/draw-app-icon.swift. -->
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>
  <!-- sherpa-onnx's native library, built by scripts/build-sherpa-ios.sh. -->
  <ItemGroup>
    <NativeReference Include="$(RepoRoot)native/ios/SherpaOnnxC.xcframework" Kind="Framework" />
  </ItemGroup>
  <!-- The voice and speech models, downloaded by scripts/get-models.sh, go inside the app. -->
  <ItemGroup>
    <BundleResource Include="$(RepoRoot)models/**/*" Exclude="$(RepoRoot)models/README.md"
                    Link="models/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SpellingBee.App/SpellingBee.App.csproj" />
    <ProjectReference Include="../SpellingBee.Infrastructure.Files/SpellingBee.Infrastructure.Files.csproj" />
    <ProjectReference Include="../SpellingBee.Infrastructure.Sherpa/SpellingBee.Infrastructure.Sherpa.csproj" />
    <ProjectReference Include="../SpellingBee.Infrastructure.iOS/SpellingBee.Infrastructure.iOS.csproj" />
  </ItemGroup>
</Project>
