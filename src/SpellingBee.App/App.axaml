<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpellingBee.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SpellingBee.App/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://SpellingBee.App/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SpellingBee.App/Styles/KidTheme.axaml" />
    <StyleInclude Source="avares://SpellingBee.App/Styles/KidButtons.axaml" />
  </Application.Styles>
</Application>
