<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Text, game pieces and the grown-up area. Buttons are in KidButtons.axaml. -->

  <!-- Base: one kid-friendly typeface, dark ink on cream. MainView sets the same, because the
       iPad has no Window; this covers the Mac window's edges while it resizes. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource KidFont}" />
    <Setter Property="Background" Value="{StaticResource CreamBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <!-- Text hierarchy: title, screen title, label, detail. -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="72" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.screen-title">
    <Setter Property="FontSize" Value="44" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.menu-label">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.menu-detail">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Choose words: list row text. -->
  <Style Selector="Button.list-row TextBlock.list-name">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.list-row TextBlock.list-detail">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Progress badges: one same-size circle per word, no letters. -->
  <Style Selector="Border.word-badge">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
  </Style>
  <Style Selector="Border.word-badge PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.word-badge.current">
    <Setter Property="BorderBrush" Value="{StaticResource CurrentBlueBrush}" />
    <Setter Property="BorderThickness" Value="6" />
    <Setter Property="Background" Value="{StaticResource CurrentTintBrush}" />
  </Style>
  <Style Selector="Border.word-badge.right">
    <Setter Property="Background" Value="{StaticResource RightGreenBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RightGreenBrush}" />
  </Style>
  <Style Selector="Border.word-badge.missed">
    <Setter Property="Background" Value="{StaticResource MissedOrangeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MissedOrangeBrush}" />
  </Style>
  <Style Selector="Border.word-badge.missed.current">
    <Setter Property="BorderBrush" Value="{StaticResource CurrentBlueBrush}" />
  </Style>

  <!-- Status: a light and a word on one line, saying whether to listen, wait, or spell now. -->
  <Style Selector="StackPanel.status-row">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="20" />
  </Style>
  <Style Selector="Border.status-light">
    <Setter Property="Width" Value="96" />
    <Setter Property="Height" Value="96" />
    <Setter Property="CornerRadius" Value="48" />
  </Style>
  <Style Selector="Border.status-light PathIcon">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.status-light.speaking">
    <Setter Property="Background" Value="{StaticResource BeeYellowBrush}" />
  </Style>
  <Style Selector="Border.status-light.speaking PathIcon">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Border.status-light.waiting">
    <Setter Property="Background" Value="{StaticResource WaitGreyBrush}" />
  </Style>
  <Style Selector="Border.status-light.your-turn">
    <Setter Property="Background" Value="{StaticResource RightGreenBrush}" />
  </Style>
  <Style Selector="TextBlock.status-word">
    <Setter Property="FontSize" Value="48" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Answer strip: a line the letters sit on, filled from the leading edge. One letter tall,
       so it takes little room before the child starts. -->
  <Style Selector="Border.answer-strip">
    <Setter Property="MinHeight" Value="148" />
    <Setter Property="BorderThickness" Value="0,0,0,4" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
  </Style>

  <!-- Answer letters: the big boxes in the middle. -->
  <Style Selector="Border.letter-box">
    <Setter Property="Width" Value="112" />
    <Setter Property="Height" Value="132" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="BorderThickness" Value="5" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="Background" Value="{StaticResource CreamBrush}" />
  </Style>
  <Style Selector="Border.letter-box TextBlock">
    <Setter Property="FontSize" Value="88" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.letter-box.heard">
    <Setter Property="BorderBrush" Value="{StaticResource CurrentBlueBrush}" />
  </Style>
  <Style Selector="Border.letter-box.right">
    <Setter Property="Background" Value="{StaticResource RightGreenBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RightGreenBrush}" />
  </Style>
  <Style Selector="Border.letter-box.right TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.letter-box.correction">
    <Setter Property="Background" Value="{StaticResource MissedTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MissedOrangeBrush}" />
  </Style>
  <Style Selector="Border.letter-box.teaching">
    <Setter Property="Background" Value="{StaticResource TeachTintBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TeachPurpleBrush}" />
  </Style>

  <!-- A gentle pulse for "your turn" and "tap me". -->
  <Style Selector=":is(Control).pulse">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.55" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Grown-up area: standard macOS sizes (13 pt default, never below 10). -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,16,0,6" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.settings-group">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>
</Styles>
