<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Every button the child sees, following Apple's Human Interface Guidelines:
    - Choices shown together are the same size; the likely one is set apart by style (yellow), not size.
    - At most one yellow (primary) button per screen.
    - Hit areas are well over 44 pt, with at least 12 pt between buttons.
    - Every button has a hover and a pressed look (Fluent also shrinks it slightly while pressed).
    Fluent paints hover and pressed on the template's ContentPresenter, so those states are set there.
  -->

  <!-- Toolbar: Back and Home, top left of every child screen. -->
  <Style Selector="Button.toolbar">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.toolbar PathIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>

  <!-- Settings: a labelled pill, top right of the start screen. -->
  <Style Selector="Button.pill">
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource SoftInkBrush}" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.pill PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <!-- Large pill: a secondary action beside other content (Say it again). -->
  <Style Selector="Button.pill.large">
    <Setter Property="Height" Value="80" />
    <Setter Property="Padding" Value="28,0" />
    <Setter Property="CornerRadius" Value="40" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button.pill.large PathIcon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- Action: a big square button with an icon and a word (Start, Hear it again, Play again). -->
  <Style Selector="Button.action">
    <Setter Property="Width" Value="220" />
    <Setter Property="Height" Value="180" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.action PathIcon">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <!-- Start menu rows. -->
  <Style Selector="Button.menu-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="120" />
    <Setter Property="Padding" Value="32,16" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.menu-item PathIcon">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="0,0,24,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Choose words: one full-width row per saved list, top to bottom. -->
  <Style Selector="Button.list-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="104" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Padding" Value="28,16" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- The list used last time: blue outline plus a tick, so it isn't shown by colour alone. -->
  <Style Selector="Button.list-row.chosen">
    <Setter Property="BorderBrush" Value="{StaticResource CurrentBlueBrush}" />
  </Style>

  <!-- On-screen keyboard. -->
  <Style Selector="Button.key">
    <Setter Property="Width" Value="84" />
    <Setter Property="Height" Value="76" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.key PathIcon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- Grown-up ✓ / ✗ when the microphone mishears. -->
  <Style Selector="Button.verdict">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
    <Setter Property="CornerRadius" Value="36" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.verdict.right">
    <Setter Property="Background" Value="{StaticResource RightGreenBrush}" />
  </Style>
  <Style Selector="Button.verdict.wrong">
    <Setter Property="Background" Value="{StaticResource MissedOrangeBrush}" />
  </Style>

  <!-- Primary: the one most likely action on the screen. Same shape, yellow fill. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource BeeYellowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BeeAmberBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button.key.primary">
    <Setter Property="Background" Value="{StaticResource RightGreenBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RightGreenBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Hover and pressed, for every child button above. -->
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.menu-item:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.list-row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.key:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BeeAmberBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.menu-item:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.list-row:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.key:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BeeAmberBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BeeYellowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BeeAmberBrush}" />
  </Style>
  <Style Selector="Button.key.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource RightGreenBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.verdict:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
</Styles>
