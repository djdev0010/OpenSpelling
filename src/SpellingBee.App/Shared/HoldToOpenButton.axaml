<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpellingBee.App.Shared.HoldToOpenButton"
             Width="64" Height="64" Cursor="Hand">
  <!-- A small lock with a ring that fills while it is held down. -->
  <Panel>
    <Ellipse Fill="White" Stroke="#D9D2C0" StrokeThickness="3" />
    <Arc x:Name="ProgressRing"
         Stroke="{StaticResource CurrentBlueBrush}" StrokeThickness="6"
         StartAngle="-90" SweepAngle="0" Margin="2" />
    <PathIcon Data="{StaticResource LockIcon}" Width="26" Height="26"
              Foreground="{StaticResource SoftInkBrush}" />
  </Panel>
</UserControl>
