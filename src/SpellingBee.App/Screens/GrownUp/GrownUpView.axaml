<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grownUp="using:SpellingBee.App.Screens.GrownUp"
             x:Class="SpellingBee.App.Screens.GrownUp.GrownUpView"
             x:DataType="grownUp:GrownUpViewModel">
  <DockPanel Margin="32,24">

    <!-- Header: Cancel on the leading side, Save (the default action) on the trailing side. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,*" Margin="0,0,0,24">
      <Button Command="{Binding CloseWithoutSavingCommand}" Content="Cancel"
              Padding="20,8" MinHeight="36" IsCancel="True" />
      <TextBlock Grid.Column="1" Classes="heading" Text="Settings" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="accent" Command="{Binding SaveAndCloseCommand}" Content="Save"
              Padding="24,8" MinHeight="36" IsDefault="True" HorizontalAlignment="Right" />
    </Grid>

    <Grid ColumnDefinitions="*,24,*">
      <!-- Leading: the spelling lists. -->
      <Border Classes="settings-group">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Spelling lists" />
          <grownUp:SpellingListsView DataContext="{Binding SpellingLists}" />
        </DockPanel>
      </Border>

      <!-- Trailing: how the child answers, voice, then the microphone. -->
      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="24">
          <Border Classes="settings-group">
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="How does your child spell?" />
              <RadioButton GroupName="AnswerMode" IsChecked="{Binding SpellOutLoud}">
                <StackPanel>
                  <TextBlock Text="Out loud" FontWeight="Bold" />
                  <TextBlock Classes="hint" Text="Says each letter; the microphone listens." />
                </StackPanel>
              </RadioButton>
              <RadioButton GroupName="AnswerMode" IsChecked="{Binding UseOnScreenKeyboard}">
                <StackPanel>
                  <TextBlock Text="Tap letters" FontWeight="Bold" />
                  <TextBlock Classes="hint" Text="Taps each letter on a big keyboard on the screen." />
                </StackPanel>
              </RadioButton>

              <!-- Letter order: only matters when tapping letters. -->
              <StackPanel IsEnabled="{Binding UseOnScreenKeyboard}" Margin="28,4,0,0" Spacing="4">
                <TextBlock Classes="label" Text="Keyboard letter order" Margin="0,0,0,2" />
                <RadioButton GroupName="KeyboardOrder" IsChecked="{Binding UseAlphabeticalKeyboard}" Content="A to Z (ABCDEF…)" />
                <RadioButton GroupName="KeyboardOrder" IsChecked="{Binding UseQwertyKeyboard}" Content="Like a real keyboard (QWERTY…)" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="settings-group">
            <StackPanel>
              <TextBlock Classes="section" Text="Voice" />
              <grownUp:VoicePickerView DataContext="{Binding VoicePicker}" />
              <TextBlock Classes="hint" Text="{Binding PreparationStatus}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Classes="settings-group">
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="Microphone" />
              <TextBlock Classes="hint" Text="{Binding MicrophoneStatus}" />
              <CheckBox Content="Accept sound-alike letters (B for D, M for N…)" IsChecked="{Binding AcceptSoundAlikeLetters}" />
              <CheckBox Content="Show ✓ / ✗ buttons so I can correct the microphone" IsChecked="{Binding ShowGrownUpOverrideButtons}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
