<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grownUp="using:SpellingBee.App.Screens.GrownUp"
             x:Class="SpellingBee.App.Screens.GrownUp.GrownUpView"
             x:DataType="grownUp:GrownUpViewModel">
  <DockPanel Margin="32">

    <!-- Header with back and save. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
      <Button Command="{Binding CloseWithoutSavingCommand}" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource BackIcon}" Width="18" Height="18" />
          <TextBlock Text="Back without saving" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="1" Classes="heading" Text="Grown-up settings" HorizontalAlignment="Center" />
      <Button Grid.Column="2" Classes="accent" Command="{Binding SaveAndCloseCommand}" Padding="20,8" Content="Save" />
    </Grid>

    <Grid ColumnDefinitions="*,32,*">
      <!-- Left: the saved spelling lists. -->
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Margin="0,12,0,0"
                Content="Start over (reset progress)" Command="{Binding ResetProgressCommand}" />
        <grownUp:SpellingListsView DataContext="{Binding SpellingLists}" />
      </DockPanel>

      <!-- Right: voice and options. -->
      <ScrollViewer Grid.Column="2">
        <StackPanel>
          <grownUp:VoicePickerView DataContext="{Binding VoicePicker}" />
          <TextBlock Classes="hint" Text="{Binding PreparationStatus}" Margin="0,6,0,0" />

          <TextBlock Classes="label" Text="Listening" />
          <TextBlock Classes="hint" Text="{Binding MicrophoneStatus}" />
          <CheckBox Content="Use the letter keyboard instead of the microphone" IsChecked="{Binding UseOnScreenKeyboard}" />
          <CheckBox Content="Accept sound-alike letters (B for D, M for N…)" IsChecked="{Binding AcceptSoundAlikeLetters}" />
          <CheckBox Content="Show ✓ / ✗ buttons so I can correct the microphone" IsChecked="{Binding ShowGrownUpOverrideButtons}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
