<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grownUp="using:SpellingBee.App.Screens.GrownUp"
             x:Class="SpellingBee.App.Screens.GrownUp.SpellingListsView"
             x:DataType="grownUp:SpellingListsViewModel">
  <DockPanel>
    <!-- Which saved list to play, plus add and delete. -->
    <TextBlock DockPanel.Dock="Top" Classes="label" Text="List to play" Margin="0,0,0,6" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto">
      <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}"
                HorizontalAlignment="Stretch" FontSize="18">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="grownUp:EditableSpellingListViewModel">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Margin="8,0,0,0" Content="New list" Command="{Binding AddListCommand}" />
      <Button Grid.Column="2" Margin="8,0,0,0" Content="Delete list" Command="{Binding DeleteSelectedListCommand}" />
    </Grid>

    <!-- The chosen list's name and words. -->
    <TextBlock DockPanel.Dock="Top" Classes="label" Text="List name" />
    <TextBox DockPanel.Dock="Top" Text="{Binding SelectedList.Name}" FontSize="18"
             TextInputOptions.ReturnKeyType="Done" />
    <TextBlock DockPanel.Dock="Top" Classes="label" Text="Words (one per line)" />
    <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" Content="Shuffle" Command="{Binding ShuffleWordsCommand}" />
    <!-- The iPad's return key says "return" here, because it starts the next word's line. -->
    <TextBox Text="{Binding SelectedList.WordsText}" AcceptsReturn="True" FontSize="22"
             TextWrapping="NoWrap" MinHeight="220"
             TextInputOptions.Multiline="True" TextInputOptions.ReturnKeyType="Return" />
  </DockPanel>
</UserControl>
