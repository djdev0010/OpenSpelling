<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="using:SpellingBee.App.Screens.Home"
             x:Class="SpellingBee.App.Screens.Home.ChooseWordsView"
             x:DataType="home:ChooseWordsViewModel"
             x:Name="Root">
  <Grid RowDefinitions="Auto,*" Margin="24">

    <!-- Back and the question on the leading side, the shuffle switch on the trailing side. -->
    <!-- A Grid, not a StackPanel, so the question wraps on a narrow screen instead of being cut off. -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Classes="toolbar" Command="{Binding GoBackCommand}" VerticalAlignment="Top"
              ToolTip.Tip="Back" AutomationProperties.Name="Back">
        <PathIcon Data="{StaticResource BackIcon}" />
      </Button>
      <TextBlock Grid.Column="1" Classes="screen-title" Text="{Binding Heading}" TextAlignment="Left" Margin="24,0,0,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
        <PathIcon Data="{StaticResource ShuffleIcon}" Width="32" Height="32" Foreground="{StaticResource InkBrush}" />
        <TextBlock Classes="list-name" Text="Shuffle" VerticalAlignment="Center" />
        <ToggleSwitch IsChecked="{Binding ShuffleWords}" OnContent="" OffContent=""
                      AutomationProperties.Name="Shuffle the words" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- The saved lists, one row each, from the top. Last time's list has a blue outline and a tick. -->
    <ScrollViewer Grid.Row="1" Margin="88,32,88,0">
      <ItemsControl ItemsSource="{Binding SpellingLists}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="home:SpellingListCardViewModel">
            <Button Classes="list-row" Classes.chosen="{Binding IsChosen}"
                    Command="{Binding #Root.((home:ChooseWordsViewModel)DataContext).ChooseSpellingListCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="list-name" Text="{Binding Name}" />
                  <TextBlock Classes="list-detail">
                    <Run Text="{Binding WordCountText}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding WordsPreview}" />
                  </TextBlock>
                </StackPanel>
                <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="36" Height="36" Margin="24,0,0,0"
                          Foreground="{StaticResource CurrentBlueBrush}" IsVisible="{Binding IsChosen}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
