<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="using:SpellingBee.App.Screens.Game"
             x:Class="SpellingBee.App.Screens.Game.GameView"
             x:DataType="game:GameViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

    <!-- Top bar: back to the menu, and progress for grown-ups. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
      <Button Classes="home" Command="{Binding GoHomeCommand}">
        <PathIcon Data="{StaticResource HomeIcon}" />
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="20,0,0,0">
        <TextBlock Text="{Binding ProgressText}" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="{Binding RoundText}" FontSize="22" Foreground="{StaticResource SoftInkBrush}" />
      </StackPanel>
    </Grid>

    <game:WordStripView Grid.Row="1" DataContext="{Binding WordStrip}" Margin="0,16" />

    <!-- Middle: changes with the game phase. -->
    <Panel Grid.Row="2">
      <StackPanel IsVisible="{Binding IsReadyToStart}" Orientation="Horizontal" Spacing="48"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Classes="big-round" Command="{Binding StartGameCommand}">
          <PathIcon Data="{StaticResource PlayIcon}" />
        </Button>
        <Button Classes="big-round small" Command="{Binding ListenAndLearnCommand}" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource EarIcon}" Foreground="{StaticResource TeachPurpleBrush}" />
        </Button>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsPlaying}" Spacing="20" VerticalAlignment="Center">
        <Panel Height="90" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource SpeakerIcon}" Width="80" Height="80"
                    Foreground="{StaticResource BeeAmberBrush}" IsVisible="{Binding IsSpeaking}" />
          <PathIcon Classes="pulse" Data="{StaticResource MicrophoneIcon}" Width="80" Height="80"
                    Foreground="{StaticResource CurrentBlueBrush}" IsVisible="{Binding IsListening}" />
        </Panel>
        <game:AnswerLettersView DataContext="{Binding AnswerLetters}" />
        <Button Classes="big-round pulse" Command="{Binding KeepGoingCommand}"
                IsVisible="{Binding IsWaitingForChild}" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource PlayIcon}" />
        </Button>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsFinished}" Spacing="32"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource StarIcon}" Width="90" Height="90" Foreground="{StaticResource BeeYellowBrush}" />
          <PathIcon Data="{StaticResource StarIcon}" Width="120" Height="120" Foreground="{StaticResource BeeAmberBrush}" />
          <PathIcon Data="{StaticResource StarIcon}" Width="90" Height="90" Foreground="{StaticResource BeeYellowBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center">
          <Button Classes="big-round" Command="{Binding PlayAgainCommand}">
            <PathIcon Data="{StaticResource ReplayIcon}" />
          </Button>
          <Button Classes="big-round small" Command="{Binding GoHomeCommand}" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource HomeIcon}" />
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- Grown-up ✓ / ✗ when the microphone mishears (off by default). -->
      <StackPanel IsVisible="{Binding ShowGrownUpVerdictButtons}" Orientation="Horizontal"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Classes="verdict right" Command="{Binding MarkSpelledRightCommand}">
          <PathIcon Data="{StaticResource CheckIcon}" />
        </Button>
        <Button Classes="verdict wrong" Command="{Binding MarkSpelledWrongCommand}">
          <PathIcon Data="{StaticResource CrossIcon}" />
        </Button>
      </StackPanel>
    </Panel>

    <Panel Grid.Row="3" IsVisible="{Binding ShowKeyboard}">
      <game:LetterKeyboardView DataContext="{Binding Keyboard}" />
    </Panel>
  </Grid>
</UserControl>
