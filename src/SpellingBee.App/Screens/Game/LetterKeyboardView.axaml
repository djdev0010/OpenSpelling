<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="using:SpellingBee.App.Screens.Game"
             x:Class="SpellingBee.App.Screens.Game.LetterKeyboardView"
             x:DataType="game:LetterKeyboardViewModel">
  <StackPanel HorizontalAlignment="Center">
    <ItemsControl ItemsSource="{Binding Keys}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="9" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="game:LetterKeyViewModel">
          <Button Classes="key" Content="{Binding Letter}" Command="{Binding PressCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Classes="key" Width="140" Command="{Binding PressEraseCommand}">
        <PathIcon Data="{StaticResource BackspaceIcon}" />
      </Button>
      <Button Classes="key done" Width="180" Command="{Binding PressDoneCommand}">
        <PathIcon Data="{StaticResource CheckIcon}" />
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>
