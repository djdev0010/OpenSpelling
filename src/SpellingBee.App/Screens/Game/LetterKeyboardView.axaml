<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="using:SpellingBee.App.Screens.Game"
             x:Class="SpellingBee.App.Screens.Game.LetterKeyboardView"
             x:DataType="game:LetterKeyboardViewModel">
  <StackPanel HorizontalAlignment="Center">
    <!-- One centred row of keys per line, like a real keyboard. -->
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:Object">
          <ItemsControl ItemsSource="{Binding}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="game:LetterKeyViewModel">
                <Button Classes="key" Content="{Binding Letter}" Command="{Binding PressCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- Erase and Done are wide, far apart, and labelled, so neither is tapped by mistake. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="48" Margin="0,8,0,0">
      <Button Classes="key" Width="220" Command="{Binding PressEraseCommand}"
              ToolTip.Tip="Erase" AutomationProperties.Name="Erase">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <PathIcon Data="{StaticResource BackspaceIcon}" />
          <TextBlock Classes="key-label" Text="Oops" />
        </StackPanel>
      </Button>
      <Button Classes="key primary" Width="260" Command="{Binding PressDoneCommand}"
              ToolTip.Tip="Done" AutomationProperties.Name="Done">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <PathIcon Data="{StaticResource CheckIcon}" />
          <TextBlock Classes="key-label" Text="Done" />
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>
